# den2syn writes through Synapse's storage code, so it runs in the Synapse
# image matching sources/synapse.
FROM matrixdotorg/synapse:v1.163.0

# psql and pg_isready for the helper scripts.
RUN apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client \
    && rm -r /var/lib/apt/lists/*

WORKDIR /app

COPY den2syn/ ./den2syn/
COPY tests/ ./tests/
COPY integration-test/scripts/ ./
RUN chmod +x *.sh

RUN mkdir -p /logs

ENV PGPASSWORD=matrix_password

ENTRYPOINT ["./wait-for-db.sh"]
